{
  "name": "pyo-web",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "bun run sync-docs && vite dev --port 3000",
    "build": "bun run sync-docs && bun run scripts/write-index-files.ts && vite build",
    "preview": "vite preview --port 3000",
    "typecheck": "tsc --noEmit",
    "screenshots": "mkdir -p .screens-raw && node scripts/screenshots/capture.mjs && python3 scripts/screenshots/optimize.py",
    "sync-templates": "bun run scripts/sync-templates.ts",
    "sync-docs": "bun run scripts/sync-docs.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/start-static-server-functions": "^1.167.44",
    "@types/mdx": "^2.0.14",
    "fumadocs-core": "^16.18.0",
    "fumadocs-mdx": "^15.4.10",
    "fumadocs-openapi": "^12.6.0",
    "fumadocs-ui": "^16.18.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright-core": "^1.56.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.7.2",
    "vite": "8.3.2",
    "yaml": "^2.9.1"
  }
}
